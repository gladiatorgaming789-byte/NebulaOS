[Unit]
Description=Configure NebulaForge live-session user groups
After=live-config.service
Before=display-manager.service
ConditionPathExists=/usr/local/sbin/nebula-live-user-setup

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nebula-live-user-setup
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
